<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Perch.SearchWindow"
        Title="Perch"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual">
  <Grid>
    <Border x:Name="Shell" HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="460" Height="520" CornerRadius="22" Padding="18"
            BoxShadow="0 24 60 0 #33000000">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBox x:Name="Query" Padding="14,10" FontSize="15" />
          <Button x:Name="Clear" Grid.Column="1" Content="×" Width="36" Margin="8,0,0,0" />
        </Grid>
        <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="12" />
        <ScrollViewer>
          <StackPanel>
            <TextBlock x:Name="Empty" HorizontalAlignment="Center" Margin="0,56,0,0" FontSize="14" />
            <StackPanel x:Name="Rows" Spacing="4" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
